      "criteria": { "ltv_range": "low" },
      "estimated_size_percent": 40
    }
  ],
  "trigger_chains": [
    {
      "name": "welcome_chain",
      "description": "Welcome-цепочка для новых пользователей",
      "emails": [
        {
          "step": 1,
          "delay": "immediate",
          "subject": "Добро пожаловать в smart-skidka.ru! Ваша экономия начинается",
          "template": "welcome_1",
          "description": "Приветствие + гайд по платформе + топ-5 скидок недели"
        },
        {
          "step": 2,
          "delay": "2d",
          "subject": "Лучшие скидки недели, которые нельзя пропустить 🔥",
          "template": "welcome_2",
          "description": "Подборка по популярным категориям с реальными цифрами экономии"
        },
        {
          "step": 3,
          "delay": "5d",
          "subject": "Выберите любимые категории — получайте персональные скидки",
          "template": "welcome_3",
          "description": "Призыв подписаться на категории для персонализации"
        }
      ]
    },
    {
      "name": "price_drop_trigger",
      "description": "Триггер снижения цены на отслеживаемые товары",
      "emails": [
        {
          "step": 1,
          "delay": "immediate",
          "subject": "🔥 Цена упала на {discount}%! {product_name} — выгода {savings} ₽",
          "template": "price_drop",
          "description": "Мгновенное уведомление при снижении цены на 10%+"
        }
      ],
      "condition": "price_drop >= 10% AND product_is_watched"
    },
    {
      "name": "abandoned_cart",
      "description": "Триггер брошенной корзины",
      "emails": [
        {
          "step": 1,
          "delay": "24h",
          "subject": "Вы забыли кое-что важное... Скидка на {product_name} ждёт",
          "template": "abandoned_cart_1",
          "description": "Напоминание через 24 часа"
        },
        {
          "step": 2,

      "estimated_size_percent": 18
    },
    {
      "name": "Спорт",
      "criteria": { "interests": ["sport", "fitness", "outdoor"] },
      "estimated_size_percent": 12
    },
    {
      "name": "Детские товары",
      "criteria": { "interests": ["kids", "toys", "baby"] },

# Dockerfile для Telegram Bot smart-skidka-agents
FROM python:3.12-slim-bookworm

WORKDIR /app

# Системные зависимости
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Python-зависимости
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Приложение
COPY scripts/telegram_reporter.py ./scripts/
COPY scripts/validator.py ./scripts/

# Запуск
CMD ["python", "-m", "scripts.telegram_reporter"]

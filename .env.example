# ═══════════════════════════════════════════════════════════════════
# Пример конфигурации окружения (НЕ содержит реальных секретов)
# Скопируйте этот файл в .env и заполните своими значениями.
# Файл .env НЕ должен попадать в git (он уже в .gitignore).
# ═══════════════════════════════════════════════════════════════════

# ═══ LLM / RouterAI ═══
LLM_API_KEY=sk-your-routerai-or-deepseek-key-here
LLM_API_URL=https://routerai.ru/api/v1/chat/completions
DEFAULT_LLM_MODEL=nvidia/nemotron-nano-9b-v2

# ═══ Kimi fallback (опционально) ═══
KIMI_API_KEY=

# ═══ Жизненный цикл агентов ═══
CYCLE_INTERVAL=43200

# ═══ Telegram Bot ═══
TELEGRAM_BOT_TOKEN=123456789:AAHxxxyyyzzz...
TELEGRAM_CHAT_ID=123456789
TELEGRAM_CHANNEL_ID=-1001234567890

# ═══ База данных и кэш ═══
DATABASE_URL=postgresql://user:password@localhost:5432/skidka_agents
REDIS_URL=redis://:password@localhost:6379/0

# ═══ Yandex Metrika ═══
YANDEX_METRIKA_TOKEN=

# ═══ Dashboard ═══
DASHBOARD_PORT=8081
DASHBOARD_API_KEY=

# ═══ Secrets manager master key (64 hex chars) ═══
# Можно сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRETS_MASTER_KEY=

# ═══ Путь к корню сайта (для файловых действий агентов) ═══
PROJECT_ROOT=/var/www/dealshub-miniapp
